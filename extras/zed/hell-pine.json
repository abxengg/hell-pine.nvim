            "color": "#ebbcba"
          },
          "constant": {
            "color": "#658789"
          },
          "function": {
            "color": "#ebbcba"
          },
          "type": {
            "color": "#9ccfd8"
          },
          "constructor": {
            "color": "#9ccfd8"
          },
